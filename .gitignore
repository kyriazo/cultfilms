# Ignore directories generated by Composer
/drush/contrib/
/vendor/
public_html/core/
public_html/modules/contrib/
public_html/themes/contrib/
public_html/profiles/contrib/
node_modules

# Ignore sensitive information
public_html/sites/*/settings.local.php
public_html/sites/*/services.local.yml
public_html/sites/*/services.yml

# Ignore Drupal's file directory
public_html/sites/*/files/

# Ignore SimpleTest multi-site environment.
public_html/sites/simpletest

# Ignore files generated by PhpStorm and other IDEs.
/.idea/
/.vscode/

# Ignore files generated by Mac OS.
.DS_Store

# Ignore .env files as they are personal
/.env

# Ignore developer scripts folders.
/.scripts_dev

# public_html/sites/default/settings.php
public_html/sites/example.settings.local.php
temporary/.htaccess

private/application_files/*
private/*